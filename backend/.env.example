# ================================
# DevChat Backend Environment Vars
# ================================

# Server
PORT=5000
NODE_ENV=development

# MySQL Database (use PlanetScale/Railway/Aiven for production)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=''
DB_NAME=devchat

# JWT Secret (use a long random string in production!)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# AES-256 Encryption Key (MUST be exactly 32 bytes / 64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2

# Frontend URL for CORS (change to your Vercel URL in production)
FRONTEND_URL=http://localhost:3000

# Optional: Railway/Render auto-sets PORT
